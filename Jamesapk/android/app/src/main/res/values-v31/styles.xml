<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ replaces the windowBackground launch screen with a system
         splash (app icon on a solid color). Style it to match the app's LIGHT
         background with the transparent roof mark, so it flows straight into
         the animation preloader with no white icon box. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#F3F4F6</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>
