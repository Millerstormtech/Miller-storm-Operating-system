.next/
node_modules/
dist/
.env
# Broader than `.env.*.local`, which does NOT match a plain `.env.local`.
.env*.local
*.log
firebase-service-account.json
*.plist
google-services.json
# ...but the Android app's google-services.json IS needed at build time by the
# google-services gradle plugin, so keep this one in version control.
!Jamesapk/android/app/google-services.json

# Build artifacts / OS files
.DS_Store
tsconfig.tsbuildinfo

# Local-only product/planning docs (kept off GitHub on purpose)
docs/

# Quiz answer-balancing tooling. Kept local because its input is docs/quizzes/,
# which is already gitignored — the scripts are useless without it.
scripts/quiz-balance/

# Local-only AI assistant guidance (kept off GitHub on purpose)
CLAUDE.md
# `.claude/*` (contents), not `.claude/` (the directory), because git will not
# descend into an excluded directory, and that would make the negation below a no-op.
.claude/*
!.claude/smoke-test-profile.md

# Local dev database (mongodb-memory-server). Holds a COPY OF PROD DATA, never commit.
.localdb/

# Local-only dev scaffolding for the seeded preview DB (contains roster fixtures)
scripts/dev/

# Brainstorming visual-companion scratch files
.superpowers/
